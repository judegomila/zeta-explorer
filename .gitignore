node_modules/
dist/
# observatory/dist is hand-maintained source, not build output.
!/observatory/dist/
.vite/
*.log
scripts/logs/
scripts/.auto-improve*.pid
scripts/.rate-limit-backoff-state*
scripts/.env
scripts/queue-index.json

# imp-1278 ssr-pool supervisor: local-only runtime state
scripts/.ssr-pool.pid
scripts/.vite-ssr-pool.sock

# Rust build artifacts (imp-1090 interval-rk4 backend)
rust/*/target/
rust/*/Cargo.lock

# imp-1131 large-file regression prevention (2026-05-19): the engine accidentally
# committed the session-archive extraction directory + the on-disk tar.gz. These
# files are NOT project content; they are local cache/extraction artifacts.
-Users-USER-Code-Experiments-mathexplorer/
mathexplorer-claude-sessions-*.tar.gz
*.tar.gz

# imp-1143 worktree harness — local-only
.worktrees/

# thinking/ infrastructure: persistent reasoning logs. decisions/ are
# git-tracked (audit trail); transcripts/ are raw subagent JSONL captures
# (large, ephemeral) — keep only the .gitkeep marker.
thinking/transcripts/*
!thinking/transcripts/.gitkeep

# Vercel deploy hook (secret) + publisher state — never commit
scripts/.deploy-hook-url
scripts/.deploy-hook-state
scripts/.deploy-hook-gate-state
scripts/.rh-lit-seen.json
.superpowers/
.aider*

# Vercel CLI local state / prebuilt build output (must NOT be committed — causes stale-prebuilt deploys)
.vercel/
scripts/.deploy-hook-url-editorial
scripts/.deploy-editorial-state
scripts/.deploy-editorial.log
scripts/.fleet-status-gist-id
scripts/.fleet-status-publish.log
.venv-arb/
.lake/
**/.lake/

# --- public-repository hygiene (see CONTRIBUTING.md) ---
# scratch work lives in the private companion repository
tmp/
# agent and session state
.claude/
.claude-memory/
.superpowers/
.aider*
thinking/
-Users-*/
*.jsonl.gz
# machine state: every dot file under scripts/ except the env example
scripts/.*
!scripts/.env.example
public/fleet-status.json
logs/
out/
test-results/
*.pid
seed_err.txt
# credentials
.env
.env.*
!.env.example
!scripts/.env.example
*.pem
*.key
# OS, caches, build outputs
.DS_Store
**/.DS_Store
__pycache__/
*.pyc
.lake/
**/.lake/
*.bundle.mjs
# renderer field packs are generated at build time
observatory/dist/precache/projective-*.bin.gz
