  "source_conventions": {
    "locked_conventions": {
      "claim_boundary": "all finite pilots are diagnostics or exact algebraic regressions; no signed floor or asymptotic residual-gap conclusion is inferred",
      "combined_exterior": "soft and hard exterior levels are formed from the complete combined nonnegative defect before blockwise absolute values",
      "fourier": "fhat(t)=integral f(s)*exp(-i*t*s)ds with Plancherel measure dt/(2*pi)",
      "input_limits": "producer and verifier admit only lambda_numerator in {5,9} and dps in {80,160}",
      "input_text": "lambda numerator and precision are canonical positive integer text; binary64 parameters and JSON floating-point values are rejected",
      "inversion": "J is physical reflection s->-s; inversion parity is not replaced by positive-frequency selection",
      "limiting_state": "h(x)=(pi/2)*x^2*(2*pi*x^2-3)*exp(-pi*x^2), E(h)(u)=sqrt(u)*sum_(m>=1)h(m*u), K(s)=E(h)(exp(s))",
      "limiting_transform": "the source-normalized full transform is Khat(t)=Xi(t)/4, not Xi(t)",
      "periodic_basis": "phi_n(s)=(-1)^n*L^(-1/2)*exp(2*pi*i*n*s/L), abs(n)<=N",
      "physical_domain": "I_lambda=[-log(lambda),log(lambda)] with L=2*log(lambda), logarithmic Lebesgue measure, and zero extension",
      "prime_block": "-2*sum_(1<n<=lambda^2) Lambda(n)/sqrt(n)*cos(t*log(n)); the endpoint is inclusive and the minus sign is immutable",
      "projected_cross_gram": "finite projected pole/source cross Grams are assembled through the exact Fourier parity projector and are not replaced by the unprojected floor-integral formula",
      "runtime": "mpmath==1.4.1 with outward mpmath.iv enclosures is required",
      "source_domain": "[-lambda,lambda] with Lebesgue measure and zero extension; the fixed source-normalized h_lambda is never unit-normalized"
    },
    "locked_formulas": {
      "anchor_obstruction": "the distinguished normalized anchor has constant-direction overlap O(L^(-1/2)) while the constant direction has fixed central energy beta_delta>0",
      "bv_layer": "J<=V/pi^2*(2*z-z^2/2) for z<=1 and J<=V/pi^2*(3/2+log(z)) for z>=1, z=L*M/V",
      "effective_tail": "r_sigma<=p_X+chi_X/sigma and sum_(gamma_j<=sigma)gamma_j<=chi_X/(1-sigma), with the threshold endpoint retained in the low tail",
      "finite_moment_obstruction": "for every fixed k there are positive spectral measures with equal moments through k and exact loads 1 plus-or-minus epsilon*Delta_n/S_n",
      "first_riesz": "F(X)=integral_1^X(psi_C(t)-t)dt/t=-sum_rho (X^rho-1)/rho^2-log(2*pi)*log(X)+pi^2/24-Li_2(X^(-2))/4",
      "graph_bv": "Gamma^2<=L/(2*pi^2*M)*sum_a TV_per(g_a)^2",
      "graph_spill": "sqrt(rho_B)<=sqrt(B_(r,M))*sqrt(delta/pi)/(1-B_(r,N))+Gamma, Gamma=norm((P_N-P_M)*W*Y*D^(1/2))_HS",
      "layer_average": "integral_0^A tr(C_(X,s)-C_(X,s)^2)ds=(1/2)*double_integral abs(d(t)-d(u))*abs(R_X(t,u))^2dnu(t)dnu(u)",
      "matched_pole_mass": "norm(P_N*p_-)^2>=B_(lambda,N) from equation (6.3) of the odd note, forcing an uncompensated missed-pole fraction O(log(lambda)/lambda)",
      "odd_edge_localization": "L_A<=2*mu/(h+tau)+2*tau*m_tau/(h*(h+tau)), with m_tau bounded by exact power or squared-Chebyshev filters",
      "odd_harmonic_short": "s_A=2*mu*(mathcal_L_A^(-1)-1), so positivity after pole augmentation is equivalent to the original load mathcal_L_A<1",
      "odd_moment_remainder": "L_A<=L_0<=U_K and U_K-L_0=2/(h*q^(K+1))*<p,Y*(bI-Y)^(K+1)*(hI+Y)^(-1)p>",
      "pole_prime_identity": "P_lambda=-2*mu_lambda^2-lambda*A(X)+psi_C(X)/lambda+(B0(X)+B1(X))/2, X=lambda^2, with combined cancellation retained before absolute values",
      "projection_schedule": "N_star(lambda)=ceil((L^2+26*L)/(2*pi^2)); for every fixed eta<1/2, sqrt(log(lambda))*lambda^eta*norm((I-P_Nstar)f_lambda)->0",
      "projection_tail": "E_(K,N)^2<=X_(L,N)+B_lambda^2*L^3/(12*pi^4*N^3), with X_(L,N) exactly as equation (4.5) of the Mellin note",
      "riesz_obstruction": "unconditionally F(X) is not o(sqrt(X)); conditional on RH the normalized pole-plus-archimedean expression has a nonconstant absolutely convergent almost-periodic zero term around c0=1+gamma_E/2-log(2*sqrt(pi))",
      "soft_transition": "chi_X=integral a*(1-a)*R_X(t,t)dnu+(1/2)*double_integral abs(a(t)-a(u))^2*abs(R_X(t,u))^2dnu(t)dnu(u)",
      "tail_constant": "B_lambda=2*C_sum*(B1*lambda^(13/2)*exp(-pi*lambda^2)+B2*Gamma(17/4,pi*lambda^2)/(2*pi^(17/4)))",
      "xi_envelope": "abs(Xi(t))<=C_Xi*(t^2+1/4)^(13/8)*exp(-pi*abs(t)/4), C_Xi=2^(1/4)*pi^(-1/4)*Gamma(1/4)*exp(1/4)/(sqrt(2)-1)",
      "xi_transform": "integral_R K(s)*exp(-i*t*s)ds=Xi(t)/4"
