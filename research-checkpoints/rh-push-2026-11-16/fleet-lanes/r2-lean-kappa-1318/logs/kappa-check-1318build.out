@CenteredMomentEnergyCertifiedExistence.terminal_certificate : ∀ {α : Type u_1} [Fintype α] [DecidableEq α]
  (M : Ideal HeckeFamily.O) [inst : NeZero M] (H : Subgroup (HeckeFamily.O ⧸ M)ˣ)
  (hH : RayOrthogonality.globalUnits M ≤ H) (W : ℝ → ℂ) (aslot bslot a b radial Bmask L lo hi Mcap κ ε : ℝ),
  0 < aslot →
    Function.support W ⊆ Set.Icc aslot bslot →
      ContDiff ℝ (↑⊤) W →
        0 ≤ bslot →
          0 < a →
            a ≤ 1 / 4 →
              1 ≤ b →
                0 < radial →
                  0 ≤ Bmask →
                    0 < Mcap →
                      13 / 18 ≤ κ →
                        0 < ε →
                          51 / 100 ≤ HeckeZeroSupremum.beta →
                            2 * HeckeZeroSupremum.beta - 1 ≤ κ →
                              CenteredMomentEnergyCappedWidthInduction.CertifiedBand M H hH W bslot a b radial Bmask L
                                lo hi Mcap κ ε (CenteredMomentEnergyWidthSchedule.count Mcap ε)
