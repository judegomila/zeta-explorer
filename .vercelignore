# Keep the Vercel upload to just what `vite build` needs.
# Everything below is local-only engine/harness state or build artifacts.
# scripts/ and dist/ are anchored to the repo root: observatory/dist is the
# Observatory's source and observatory/scripts holds its build step.

# .git/ is NOT ignored: the project's Ignored Build Step runs `git diff HEAD^ HEAD`
# and fails with "Not a git repository" if the folder is removed.
.claude/
/scripts/
rust/
thinking/
node_modules/
/dist/
.vite/

# Local dev server (Vercel serves dist/ statically — server.js is unused there)
server.js

# Misc local artifacts
*.log
*.tar.gz
*.bak
-Users-USER-Code-Experiments-mathexplorer/

# Probes / scratch
probe-*.mjs
zprobe*.mjs
