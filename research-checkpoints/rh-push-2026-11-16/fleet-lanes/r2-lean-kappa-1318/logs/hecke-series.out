OAI.SevenEighths.HeckeFamily.LFunction_eq_LSeries : ∀ (χ : OAI.SevenEighths.HeckeFamily.Character) {s : ℂ},
  1 < s.re → OAI.SevenEighths.HeckeFamily.LFunction χ s = LSeries (OAI.SevenEighths.HeckeFamily.normCoeff χ) s
OAI.SevenEighths.HeckeFamily.LFunction_unique : ∀ (χ : OAI.SevenEighths.HeckeFamily.Character) (F : ℂ → ℂ),
  DifferentiableOn ℂ F {0, 1}ᶜ →
    (∀ (s : ℂ),
        1 < s.re → HasSum (fun I => (OAI.SevenEighths.HeckeFamily.idealCoeff χ) I / ↑(Ideal.absNorm I) ^ s) (F s)) →
      Set.EqOn F (OAI.SevenEighths.HeckeFamily.LFunction χ) {0, 1}ᶜ
OAI.SevenEighths.HeckeFamily.LFunction_eq_dedekindZeta_of_modulus_top : ∀ (χ : OAI.SevenEighths.HeckeFamily.Character),
  χ.modulus = ⊤ →
    ∀ {s : ℂ},
      1 < s.re → OAI.SevenEighths.HeckeFamily.LFunction χ s = NumberField.dedekindZeta OAI.SevenEighths.HeckeFamily.K s
OAI.SevenEighths.HeckeFamily.ne_zero_of_hasSum_of_seven_eighths_lt_re : ∀ (χ : OAI.SevenEighths.HeckeFamily.Character)
  (F : ℂ → ℂ),
  DifferentiableOn ℂ F {0, 1}ᶜ →
    (∀ (s : ℂ),
        1 < s.re → HasSum (fun I => (OAI.SevenEighths.HeckeFamily.idealCoeff χ) I / ↑(Ideal.absNorm I) ^ s) (F s)) →
      ∀ {s : ℂ}, 7 / 8 < s.re → s ≠ 1 → F s ≠ 0
