@OAI.SevenEighths.KappaThirteenEighteenths.terminal_certificate_stage_one : ∀ {α : Type u_1} [Fintype α] [DecidableEq α]
  (M : Ideal OAI.SevenEighths.HeckeFamily.O) [inst : NeZero M] (H : Subgroup (OAI.SevenEighths.HeckeFamily.O ⧸ M)ˣ)
  (hH : OAI.SevenEighths.RayOrthogonality.globalUnits M ≤ H) (W : ℝ → ℂ)
  (aslot bslot a b radial Bmask L lo hi Mcap ε : ℝ),
  0 < aslot →
    Function.support W ⊆ Set.Icc aslot bslot →
      ContDiff ℝ (↑⊤) W →
        0 ≤ bslot →
          0 < a →
            a ≤ 1 / 4 →
              1 ≤ b →
                0 < radial →
                  0 ≤ Bmask →
                    0 < Mcap →
                      0 < ε →
                        51 / 100 ≤ OAI.SevenEighths.HeckeZeroSupremum.beta →
                          OAI.SevenEighths.HeckeZeroSupremum.beta ≤ 69991 / 80000 →
                            OAI.SevenEighths.CenteredMomentEnergyCappedWidthInduction.CertifiedBand M H hH W bslot a b
                              radial Bmask L lo hi Mcap (29991 / 40000) ε
                              (OAI.SevenEighths.CenteredMomentEnergyWidthSchedule.count Mcap ε)
@OAI.SevenEighths.KappaThirteenEighteenths.terminal_certificate_of_half_add : ∀ {α : Type u_1} [Fintype α]
  [DecidableEq α] (M : Ideal OAI.SevenEighths.HeckeFamily.O) [inst : NeZero M]
  (H : Subgroup (OAI.SevenEighths.HeckeFamily.O ⧸ M)ˣ) (hH : OAI.SevenEighths.RayOrthogonality.globalUnits M ≤ H)
  (W : ℝ → ℂ) (aslot bslot a b radial Bmask L lo hi Mcap κ ε : ℝ),
  0 < aslot →
    Function.support W ⊆ Set.Icc aslot bslot →
      ContDiff ℝ (↑⊤) W →
        0 ≤ bslot →
          0 < a →
            a ≤ 1 / 4 →
              1 ≤ b →
                0 < radial →
                  0 ≤ Bmask →
                    0 < Mcap →
                      13 / 18 ≤ κ →
                        0 < ε →
                          51 / 100 ≤ OAI.SevenEighths.HeckeZeroSupremum.beta →
                            OAI.SevenEighths.HeckeZeroSupremum.beta ≤ (1 + κ) / 2 →
