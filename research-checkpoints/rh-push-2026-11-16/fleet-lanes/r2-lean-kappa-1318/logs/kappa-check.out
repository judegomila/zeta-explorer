                                (OAI.SevenEighths.CenteredMomentEnergyWidthSchedule.count Mcap ε)
OAI.SevenEighths.CenteredMomentReflectionRetainedLength.positive_slot_width_drop : ∀ (M A z xi kappa : ℝ),
  0 ≤ M →
    0 ≤ z →
      2 / 3 ≤ kappa →
        5 * M / 6 ≤ A →
          A + (6 * kappa - 1) * z ≤ M →
            3 * M / 2 - A + 2 * z + xi ≤ 7 * M / 9 + xi ∧
              3 * M / 2 - A + 2 * z + xi + (6 * kappa - 1) * z ≤ 17 * M / 18 + xi
OAI.SevenEighths.CenteredMomentEnergyLiveClippingDefect.robust_slot_budgets : ∀ (M total ell kappa defect : ℝ),
  0 ≤ ell →
    2 / 3 ≤ kappa →
      5 * M / 6 - defect ≤ total + ell →
        total + ell + (6 * kappa - 1) * ell ≤ M → ell ≤ M / 18 + defect / 3 ∧ (6 * kappa - 1) * ell ≤ M / 6 + defect
