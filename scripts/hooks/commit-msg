#!/bin/bash
# Commit-message check: the same sanitiser rules as ticket text (home paths,
# machine paths, key-shaped strings, account identifiers, pasted transcripts).
set -u
export GIT_TRACE2_EVENT=0
root="$(git rev-parse --show-toplevel 2>/dev/null)" || exit 1
cd "$root" || exit 1
command -v node >/dev/null 2>&1 || { echo "commit-msg: node not found; cannot check the message"; exit 1; }
node scripts/engine-guard.mjs message "$1"
