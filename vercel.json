{
  "$schema": "https://openapi.vercel.sh/vercel.json",
  "framework": "vite",
  "buildCommand": "vite build && node observatory/scripts/mount.mjs",
  "outputDirectory": "dist",
  "installCommand": "npm ci",
  "redirects": [
    {
      "source": "/observatory",
      "destination": "/observatory/",
      "permanent": true
    },
    {
      "source": "/",
      "has": [
        {
          "type": "query",
          "key": "view"
        }
      ],
      "destination": "/observatory/",
      "permanent": false
    },
    {
      "source": "/",
      "has": [
        {
          "type": "query",
          "key": "state"
        }
      ],
      "destination": "/observatory/",
      "permanent": false
    },
    {
      "source": "/",
      "has": [
        {
          "type": "query",
          "key": "camera"
        }
      ],
      "destination": "/observatory/",
      "permanent": false
    },
    {
      "source": "/",
      "has": [
        {
          "type": "query",
          "key": "probe"
        }
      ],
      "destination": "/observatory/",
      "permanent": false
    },
    {
      "source": "/methods.html",
      "destination": "/observatory/methods.html",
      "permanent": false
    },
    {
      "source": "/experiments/zero-channels.html",
      "destination": "/observatory/experiments/zero-channels.html",
      "permanent": false
    },
    {
      "source": "/experiments/zero-confinement.html",
      "destination": "/observatory/experiments/zero-confinement.html",
      "permanent": false
    }
  ],
  "headers": [
    {
      "source": "/observatory/(.*)",
      "headers": [
        {
          "key": "Content-Security-Policy",
          "value": "default-src 'self'; script-src 'self'; style-src 'self' 'unsafe-inline'; img-src 'self' data: blob:; font-src 'self'; connect-src 'self'; worker-src 'self'; object-src 'none'; base-uri 'self'; form-action 'self'; frame-ancestors 'self'"
        },
        {
          "key": "X-Content-Type-Options",
          "value": "nosniff"
        },
        {
          "key": "X-Frame-Options",
          "value": "SAMEORIGIN"
        },
        {
          "key": "Referrer-Policy",
          "value": "strict-origin-when-cross-origin"
        },
        {
          "key": "Permissions-Policy",
          "value": "camera=(), microphone=(), geolocation=(), payment=(), usb=(), interest-cohort=()"
        },
        {
          "key": "Cross-Origin-Opener-Policy",
          "value": "same-origin"
        }
      ]
    }
  ],
  "git": {
    "deploymentEnabled": {
      "main": true,
      "engine/work": false
    }
  },
  "build": {
    "env": {
      "PUPPETEER_SKIP_DOWNLOAD": "1",
      "PLAYWRIGHT_SKIP_BROWSER_DOWNLOAD": "1"
    }
  }
}
