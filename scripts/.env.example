# Copy to scripts/.env and fill in.
# scripts/.env is gitignored — never commit the real key.
#
# Get a key: https://console.anthropic.com/ → Settings → API Keys
# Add credits: Settings → Plans & Billing
#
# If this file is present, scripts/auto-improve.sh sources it for each
# claude --print invocation only, so the engine uses API billing while
# the rest of your shell (and this Claude Code interactive session)
# keeps using the Max OAuth subscription.

# Primary mechanism — direct API key:
ANTHROPIC_API_KEY=sk-ant-api03-REPLACE-WITH-YOUR-KEY

# Optional: if you run through a proxy (Bedrock, Vertex, custom gateway),
# set ANTHROPIC_AUTH_TOKEN instead and point ANTHROPIC_BASE_URL at the gateway.
# ANTHROPIC_AUTH_TOKEN=...
# ANTHROPIC_BASE_URL=https://...
