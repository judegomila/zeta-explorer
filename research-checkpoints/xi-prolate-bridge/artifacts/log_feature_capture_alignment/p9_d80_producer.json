      "moment_geometric_remainder": "for M_beta=qI-R, 0<=R<=(q-h)I, U_k-load is nonnegative and at most (2*||p||^2/h)*((q-h)/q)^(k+1)",
      "odd_pole_angle": "||(I-P_K)P_X p_-||^2<=(alpha_r*sqrt(sinh(L/2)-L/2)+epsilon_p_r)^2",
      "odd_pole_tail": "for p_-(x)=sinh(x/2) and its odd Taylor polynomial q_r of degree <r, epsilon_p_r^2<=L*lambda*(L/4)^(2*r)/((2*r+1)*(r!)^2)",
